# ============================================================
# Enterprise Knowledge Intelligence System - Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Embedding Model (Hugging Face Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Reranker Model (Hugging Face Cross-Encoder)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval Configuration
RETRIEVAL_TOP_K=15
RERANK_TOP_K=5

# Hybrid Search (BM25 + Dense)
HYBRID_SEARCH_ENABLED=true
BM25_WEIGHT=0.3
DENSE_WEIGHT=0.7

# File Upload Configuration
MAX_FILE_SIZE_MB=50

# Storage Paths
DATA_DIRECTORY=data
VECTOR_STORE_DIRECTORY=data/vectorstore
UPLOAD_DIRECTORY=data/uploads
EXTRACTED_DIRECTORY=data/extracted

# Database
METADATA_DATABASE_URL=sqlite:///data/database/metadata.db

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Logging
LOG_LEVEL=INFO
